# Optional — without it the pipeline runs in captions mode (on-screen text, no narration).
ELEVENLABS_API_KEY=

# Default login the capture scripts use (kit.signIn() with no `as`).
CAPTURE_EMAIL=
CAPTURE_PASSWORD=

# Additional principals as named sets — kit.signIn({ as: 'client' }) etc.
# CAPTURE_EMAIL__CLIENT=
# CAPTURE_PASSWORD__CLIENT=
# CAPTURE_EMAIL__ADMIN=
# CAPTURE_PASSWORD__ADMIN=
